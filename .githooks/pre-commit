#!/usr/bin/env bash
# Runs before every commit: lays out the staged files with Oxfmt and stages
# the result. scripts/install-git-hooks.sh points git at this folder.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
  case "$file" in
    *.js|*.mjs|*.cjs|*.css|*.json|*.jsonc|*.html|*.md|*.yml|*.yaml)
      files+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

(( ${#files[@]} )) || exit 0

# Restaging a partially staged file would commit unrelated local edits.
for file in "${files[@]}"; do
  if ! git diff --quiet -- "$file"; then
    printf 'Oxfmt: stage or stash remaining edits in %s before committing.\n' "$file" >&2
    exit 1
  fi
done

[[ -x node_modules/.bin/oxfmt ]] || {
  printf 'Oxfmt: run npm install first.\n' >&2
  exit 1
}

node_modules/.bin/oxfmt --no-error-on-unmatched-pattern -- "${files[@]}"
git add -- "${files[@]}"
